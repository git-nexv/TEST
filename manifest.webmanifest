{
  "name": "Noam Nex V Music",
  "short_name": "Nex V Music",
  "id": "/noam-nex-v-music",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "fa",
  "dir": "auto",
  "categories": ["music", "entertainment"],
  "description": "موزیک پلیر آفلاین با ظاهر Apple Music و افکت Liquid Glass",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./index.html", "accept": { "audio/mpeg": [".mp3"], "audio/mp4": [".m4a"], "audio/aac": [".aac"], "audio/wav": [".wav"], "audio/flac": [".flac"], "audio/ogg": [".ogg", ".opus"] } }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["audio/*"] }] }
  }
}
